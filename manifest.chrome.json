{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "2.1.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "assets/icons/qwacky-16.png",
    "48": "assets/icons/qwacky-48.png",
    "128": "assets/icons/qwacky-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "assets/icons/qwacky.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "contextMenus",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "https://quack.duckduckgo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://duckduckgo.com/email/*"
      ],
      "js": [
        "bypassExtensionRequirement.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://duckduckgo.com/email/*"
      ],
      "js": [
        "ddgEmailAuth.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "generate-duck-address": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "__MSG_commandGenerateAddress__"
    },
    "convert-send-address": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_commandConvertAddress__"
    }
  }
}